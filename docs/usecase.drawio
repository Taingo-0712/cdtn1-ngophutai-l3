          <mxGeometry x="280" y="700" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-5" value="Actor chính" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="730" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-6" value="Điều kiện trước" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="820" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-7" value="Truy vết" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="790" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-8" value="Mục tiêu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="760" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-9" value="Nhân viên bán hàng" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="730" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-10" value="Cập nhật giai đoạn để theo dõi tiến trình xử lý cơ hội bán hàng." style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="760" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-11" value="US5, FR5, AC5.1–AC5.3" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="790" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-12" value="Nhân viên đã đăng nhập hợp lệ. Cơ hội tồn tại, thuộc phạm vi nhân viên phụ trách, chưa có kết quả và chưa ở giai đoạn Chốt." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="820" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-13" value="Kích hoạt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="870" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-14" value="Nhân viên yêu cầu chuyển giai đoạn của cơ hội." style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="870" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-15" value="Điều kiện sau — thành công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="900" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-16" value="Cơ hội chuyển sang giai đoạn kế tiếp. Hệ thống lưu đúng một bản ghi lịch sử gồm giai đoạn cũ, giai đoạn mới, người thực hiện và thời điểm." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="900" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-17" value="Điều kiện sau — thất bại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="950" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-18" value="Giai đoạn và lịch sử giữ nguyên; không lưu một phần thay đổi." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="950" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-19" value="Luồng chính" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1000" width="120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-20" value="&lt;strong&gt;1.&lt;/strong&gt; Nhân viên mở chi tiết cơ hội.&lt;br&gt;&lt;strong&gt;2.&lt;/strong&gt; Hệ thống hiển thị thông tin và giai đoạn hiện tại.&lt;br&gt;&lt;strong&gt;3.&lt;/strong&gt; Nhân viên chọn giai đoạn kế tiếp và xác nhận chuyển.&lt;br&gt;&lt;strong&gt;4.&lt;/strong&gt; Hệ thống kiểm tra quyền, trạng thái cơ hội và tính hợp lệ của giai đoạn đích.&lt;br&gt;&lt;strong&gt;5.&lt;/strong&gt; Hệ thống cập nhật giai đoạn và ghi lịch sử trong cùng một giao dịch.&lt;br&gt;&lt;strong&gt;6.&lt;/strong&gt; Hệ thống thông báo thành công và hiển thị giai đoạn mới." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="1000" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-21" value="Ngoại lệ 4a — Ngoài phạm vi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1140" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-22" value="Tại bước 4, nhân viên không có quyền xử lý cơ hội: hệ thống từ chối, không thay đổi dữ liệu và kết thúc use case" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="1140" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-23" value="Ngoại lệ 4b — Chuyển không hợp lệ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1190" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-24" value="Tại bước 4, cơ hội đã có kết quả hoặc giai đoạn đích không phải bước kế tiếp: hệ thống báo lỗi, giữ nguyên dữ liệu; nhân viên có thể chọn lại tại bước 3 hoặc hủy." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="1190" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-25" value="Ngoại lệ 5a — Lỗi lưu dữ liệu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1240" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-26" value="Tại bước 5, cập nhật giai đoạn hoặc ghi lịch sử thất bại: hệ thống hoàn tác toàn bộ giao dịch, thông báo thất bại và kết thúc use case." style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="1240" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="PWjAXAWSnADVyAjmJNdK-27" value="Quy tắc áp dụng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1290" width="120" height="50" as="geometry" />
